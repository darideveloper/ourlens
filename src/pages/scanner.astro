---
import Layout from '../layouts/Layout.astro';
import AuthGuard from '../components/molecules/AuthGuard.tsx';
import { CameraScanner } from '../components/organisms/CameraScanner.tsx';
---

<Layout>
  <AuthGuard client:load>
    <div class="relative min-h-dvh">
      <CameraScanner client:load transition:persist="scanner" />
    </div>
  </AuthGuard>
</Layout>
