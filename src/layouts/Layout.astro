---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import OfflineIndicator from '@/components/atoms/OfflineIndicator.tsx';
import IosInstallBanner from '@/components/atoms/IosInstallBanner.tsx';
import PWAUpdatePrompt from '@/components/atoms/PWAUpdatePrompt.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Ourlens" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>Ourlens - Home Safety Scanner</title>
  </head>
  <body class="font-body text-base text-on-surface bg-surface">
    <ClientRouter />
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-brand-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-accessible">
      Skip to content
    </a>
    <OfflineIndicator client:load />
    <PWAUpdatePrompt client:load />
    <IosInstallBanner client:idle />
    <main id="main-content" transition:animate>
      <slot />
    </main>
  </body>
</html>
