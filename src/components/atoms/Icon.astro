---
export interface Props {
  name: 'search' | 'camera' | 'arrow-right' | 'check' | 'close' | 'info';
  size?: 'base' | 'lg' | 'xl';
  class?: string;
}

const { name, size = 'base', class: className = '' } = Astro.props;

const sizeMap = { base: 20, lg: 24, xl: 32 };
const dim = sizeMap[size];

const paths: Record<string, string> = {
  search:
    'M11 2a9 9 0 1 0 5.6 16.2l4.2 4.2a1 1 0 0 0 1.4-1.4l-4.2-4.2A9 9 0 0 0 11 2zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14z',
  camera:
    'M1 5a2 2 0 0 1 2-2h2.6l1.9-1.3a1 1 0 0 1 .5-.2H16a1 1 0 0 1 .5.2L18.4 3H21a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5zm2 0v14h18V5h-3.6l-1.9-1.3a1 1 0 0 0-.5-.2H7a1 1 0 0 0-.5.2L4.6 5H3zm9 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  'arrow-right':
    'M5 13h11.6l-4.3 4.3a1 1 0 0 0 1.4 1.4l6-6a1 1 0 0 0 0-1.4l-6-6a1 1 0 0 0-1.4 1.4L16.6 11H5a1 1 0 0 0 0 2z',
  check:
    'M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z',
  close:
    'M6.7 6.7a1 1 0 0 1 1.4 0L12 10.6l3.9-3.9a1 1 0 1 1 1.4 1.4L13.4 12l3.9 3.9a1 1 0 0 1-1.4 1.4L12 13.4l-3.9 3.9a1 1 0 0 1-1.4-1.4L10.6 12 6.7 8.1a1 1 0 0 1 0-1.4z',
  info:
    'M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm1 3v2h-2V7h2zm0 4v6h-2v-6h2z',
};

const viewBox = '0 0 24 24';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={dim}
  height={dim}
  viewBox={viewBox}
  fill="currentColor"
  class={`inline-block shrink-0 ${className}`.trim()}
  aria-hidden="true"
>
  <path d={paths[name] || ''} />
</svg>
