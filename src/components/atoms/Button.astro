---
export interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'base' | 'lg';
  disabled?: boolean;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'base',
  disabled = false,
  class: className = '',
} = Astro.props;

const baseClasses = 'min-h-tap min-w-tap inline-flex items-center justify-center font-semibold rounded-accessible transition-colors focus-visible:shadow-focus contrast-more:ring-2 contrast-more:ring-offset-2';

const sizeClasses = {
  base: 'px-4 py-2 text-base',
  lg: 'px-6 py-3 text-lg',
};

const variantClasses = {
  primary: 'bg-brand-500 text-white hover:bg-brand-600 active:bg-brand-700 disabled:opacity-50',
  secondary: 'bg-surface-alt text-on-surface border border-on-surface-muted/30 hover:bg-brand-100 active:bg-brand-100 disabled:opacity-50',
  ghost: 'text-brand-600 hover:bg-brand-100 active:bg-brand-100 disabled:opacity-50',
};

const classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`.trim();

const attrs: Record<string, string> = { class: classes };
if (disabled) attrs.disabled = 'true';
if (!href && type) attrs.type = type;
---

{
  href ? (
    <a href={href} {...attrs}>
      <slot />
    </a>
  ) : (
    <button {...attrs}>
      <slot />
    </button>
  )
}
