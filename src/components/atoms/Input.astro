---
export interface Props {
  name: string;
  type?: 'text' | 'email' | 'password';
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  autocomplete?: string;
  class?: string;
}

const {
  name,
  type = 'text',
  placeholder = '',
  value = '',
  required = false,
  disabled = false,
  autocomplete,
  class: className = '',
} = Astro.props;

const classes = `h-tap w-full px-4 text-base text-on-surface bg-surface-alt border border-on-surface-muted/30 rounded-accessible focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent contrast-more:border-on-surface disabled:opacity-50 ${className}`.trim();

const attrs: Record<string, string | boolean> = {
  type,
  name,
  class: classes,
};

if (placeholder) attrs.placeholder = placeholder;
if (value) attrs.value = value;
if (required) attrs.required = true;
if (disabled) attrs.disabled = true;
if (autocomplete) attrs.autocomplete = autocomplete;
---

<input {...attrs} />
