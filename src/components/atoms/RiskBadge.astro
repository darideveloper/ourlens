---
export interface Props {
  level: 'Low' | 'High';
}
const { level } = Astro.props;

const classes =
  level === 'High'
    ? 'bg-danger-500 text-white contrast-more:border-2 contrast-more:border-danger-700'
    : 'bg-safe-500 text-white';
---
<span
  class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-semibold ${classes}`}
>
  {level}
</span>