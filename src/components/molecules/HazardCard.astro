---
import RiskBadge from '@/components/atoms/RiskBadge.astro';

export interface Props {
  name: string;
  riskLevel: 'Low' | 'High';
  recommendation: string;
}

const { name, riskLevel, recommendation } = Astro.props;
---

<div
  class={`p-4 rounded-accessible border ${
    riskLevel === 'High'
      ? 'border-danger-500/50 bg-danger-50 contrast-more:border-2 contrast-more:border-danger-700'
      : 'border-on-surface-muted/20 bg-surface-alt'
  }`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-on-surface">{name}</h3>
    <RiskBadge level={riskLevel} />
  </div>
  <p class="mt-2 text-base text-on-surface-muted leading-relaxed">
    {recommendation}
  </p>
</div>