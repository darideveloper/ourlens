ALLOWED_HOSTS=localhost,127.0.0.1,ourlens.darideveloper.com

# Base URL of the self-hosted n8n instance on Hetzner VPS (no trailing slash).
# When unset, API functions fall back to dummy/mock data for local development.
# Example: https://n8n.yourdomain.com
PUBLIC_N8N_BASE_URL=

# Duration of each recording in seconds (positive integer). Default: 3.
PUBLIC_RECORD_DURATION_SECONDS=10
